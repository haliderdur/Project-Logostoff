{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "pages/**/*.ts",
    "step-definitions/**/*.ts",
    "support/**/*.ts",
    "utils/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "reports",
    "screenshots"
  ]
}